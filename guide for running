OPEN SRE DEMO STARTUP

=========================================================
PREREQUISITES
=========================================================
- Ubuntu 24.04/26.04 LTS
- Python 3.13+
- Node.js 24+
- Git
- Podman
- Kind
- kubectl
- Helm
- OpenSRE CLI

Verify:
  python3 --version
  node -v
  npm -v
  podman --version
  kubectl version --client
  kind version
  helm version
  opensre --version

=========================================================
FIRST TIME SETUP (run once)
=========================================================

1. Create Kubernetes Cluster
  sudo kind create cluster \
    --name opensre-demo \
    --config infra/kind/kind-config.yaml

  Verify: kubectl get nodes

2. Build & Load catalog-api Image
  cd catalog-api
  sudo podman build -t localhost/catalog-api:v1 .
  sudo podman save localhost/catalog-api:v1 -o catalog-api.tar
  sudo kind load image-archive catalog-api.tar --name opensre-demo
  rm catalog-api.tar
  cd ..

3. Deploy Application + Databases (all in Kind, NO docker start)
  kubectl apply -f infra/k8s/namespace.yaml
  kubectl apply -f infra/k8s/catalog-api-deployment.yaml
  kubectl apply -f infra/k8s/catalog-api-service.yaml
  kubectl apply -f infra/k8s/nginx-configmap.yaml
  kubectl apply -f infra/k8s/nginx-deployment.yaml
  kubectl apply -f infra/k8s/nginx-service.yaml
  kubectl apply -f infra/k8s/yugabytedb/
  kubectl apply -f infra/k8s/aerospike/
  # NOTE: YugabyteDB + Aerospike run as StatefulSets in namespace/databases.
  # Do NOT use `docker start yugabyte/aerospike` — those containers are deleted.
  # Dashboard reads K8s state (databases/yugabytedb-0, databases/aerospike-0).

4. Deploy Observability Stack (metrics + logs)
  ./observability/install.sh
  # This installs: VictoriaMetrics, Grafana, OpenTelemetry, vmagent,
  # Elasticsearch, Kibana, Fluent Bit

  # Verify databases are running:
  kubectl get pods -n databases
  # Should show: yugabytedb-0 1/1 Running, aerospike-0 1/1 Running
  # (YugabyteDB takes ~2-3 min on first start)

=========================================================
DAILY STARTUP (run every time)
=========================================================

TERMINAL 1 - Elasticsearch Port-Forward (REQUIRED for Logs)
  kubectl port-forward -n observability svc/es-external 9200:9200

TERMINAL 2 - Kibana Port-Forward (REQUIRED for Kibana UI)
  kubectl port-forward -n observability svc/opensre-kibana-kibana 5601:5601

TERMINAL 3 - VictoriaMetrics Port-Forward (REQUIRED for Metrics)
  kubectl port-forward -n observability svc/victoriametrics-victoria-metrics-single-server 8428:8428

TERMINAL 4 - OpenTelemetry Port-Forward (REQUIRED for Traces)
  kubectl port-forward -n observability svc/otel-collector-opentelemetry-collector 4317:4317 4318:4318

TERMINAL 4b - YugabyteDB Port-Forward (REQUIRED for backend → K8s DB)
  kubectl port-forward -n databases svc/yugabytedb 5433:5433

TERMINAL 4c - Aerospike Port-Forward (REQUIRED for backend → K8s DB)
  kubectl port-forward -n databases svc/aerospike 3001:3000
  # Host 3000 is taken by Grafana Kind mapping, so Aerospike uses 3001.
  # .env must have AEROSPIKE_HOSTS=127.0.0.1:3001 (already set).

TERMINAL 5 - Backend API
  cd opensre-backend
  source .venv/bin/activate
  uvicorn app.main:app --reload --port 8001 --host 0.0.0.0

TERMINAL 6 - Frontend
  cd frontend
  npm run dev

TERMINAL 7 - Grafana (optional, if not using Kind port 3000)
  kubectl port-forward -n observability svc/grafana 3000:80

