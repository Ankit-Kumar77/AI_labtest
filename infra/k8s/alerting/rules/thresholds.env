# Alert thresholds for the vmalert rules.
#
# THIS FILE IS THE SINGLE SOURCE OF TRUTH for every threshold. Edit a value
# here, then re-render:
#
#     python3 infra/k8s/alerting/render.py            # rewrite vmalert.yaml
#     python3 infra/k8s/alerting/render.py --check     # fail if stale (CI/test)
#     kubectl apply -f infra/k8s/alerting/vmalert.yaml
#
# Any variable may be overridden from the environment for one-off renders,
# e.g. `LATENCY_HIGH_SECONDS=0.5 python3 .../render.py`.
#
# Prometheus alert-template syntax ({{ $labels.pod }}) is untouched: only
# ${UPPER_SNAKE} placeholders are substituted.

# --- Request latency (p99, from http_request_duration_highr_seconds_bucket)
LATENCY_HIGH_SECONDS=2
LATENCY_HIGH_FOR=1m
LATENCY_CRITICAL_SECONDS=10
LATENCY_CRITICAL_FOR=2m

# --- Error rate (fraction of requests returning 5xx)
ERROR_RATE_RATIO=0.05
ERROR_RATE_PERCENT=5
ERROR_RATE_FOR=2m

# --- CPU throttling (throttled seconds / total CFS periods)
CPU_THROTTLE_RATIO=0.5
CPU_THROTTLE_PERCENT=50
CPU_THROTTLE_FOR=5m

# --- Memory
# MEMORY_RATIO only applies to containers that declare a limit; best-effort
# pods declare none, so MEMORY_ABSOLUTE_BYTES is the backstop for them.
MEMORY_RATIO=0.9
MEMORY_PERCENT=90
MEMORY_ABSOLUTE_BYTES=268435456
MEMORY_ABSOLUTE_MIB=256
MEMORY_FOR=5m

# --- Restarts (kube-state-metrics)
RESTART_WINDOW=10m
RESTART_COUNT=3

# --- Readiness
NOT_READY_FOR=2m
