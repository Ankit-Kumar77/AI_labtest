# OpenSRE Backend Configuration
# Copy this to .env and fill in your values

# OpenSRE CLI
OPENSRE_BINARY=opensre

# VictoriaMetrics
VICTORIA_METRICS_URL=http://localhost:8428

# Grafana
GRAFANA_URL=http://localhost:3000

# Aerospike
AEROSPIKE_HOSTS=127.0.0.1:3001
AEROSPIKE_NAMESPACE=test

# YugabyteDB
YUGABYTE_HOST=127.0.0.1
YUGABYTE_PORT=5433
YUGABYTE_DATABASE=yugabyte
YUGABYTE_USER=yugabyte
YUGABYTE_PASSWORD=yugabyte

# GitHub Integration
# Create a Personal Access Token (classic) at https://github.com/settings/tokens
# Required scopes: repo (for private repos) or public_repo (for public repos only)
GITHUB_TOKEN=your_github_pat_here
GITHUB_REPO=owner/repo-name
GITHUB_API_URL=https://api.github.com

# ---------------------------------------------------------------------------
# LLM provider (drives the OpenSRE RCA step)
# ---------------------------------------------------------------------------
# The agent makes SEVERAL LLM calls per investigation, so the key must cover a
# full run. OpenRouter is the default because the Gemini free tier (~20
# requests/day) is far too small for an alert-driven pipeline.
LLM_PROVIDER=openrouter
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Only used when LLM_PROVIDER=gemini. The free tier is usually exhausted.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Investigations run one at a time by default: the free OpenRouter tier rejects
# overlapping in-flight requests. Raise only if your provider has headroom.
OPENSRE_MAX_CONCURRENT_INVESTIGATIONS=1

# NOTE on OpenRouter free tiers: OpenSRE asks for a fixed 4096 output tokens
# per call. If the key reports "can only afford N" with N < 4096, raise the
# key's total limit in the OpenRouter dashboard; the limit is not tunable
# from this file.

# ---------------------------------------------------------------------------
# Alert-driven incidents
# ---------------------------------------------------------------------------
# SLACK_WEBHOOK_URL is OPTIONAL. Leave it empty to disable Slack entirely.
# Create an incoming webhook at https://api.slack.com/messaging/webhooks and
# pick the channel the alerts should post to.
#
# The webhook URL is read by the BACKEND ONLY:
#   - never sent to the browser (the UI reads SSE, not Slack)
#   - never written to disk
#   - in-cluster, set it on the opensre-backend-secrets Secret (see
#     infra/k8s/opensre-backend/secrets.example.yaml)
# A Slack outage never blocks alert ingestion or the RCA pipeline.
SLACK_WEBHOOK_URL=

# Optional override for the Slack channel (defaults to the webhook's channel)
SLACK_CHANNEL=
SLACK_TIMEOUT_S=10